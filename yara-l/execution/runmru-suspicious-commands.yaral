rule runmru_suspicious_command_clickfix {

  meta:
    author        = "Peter Stollery"
    description   = "Detects suspicious commands written to the Windows RunMRU registry key indicating potential ClickFix attack. Covers T1204.002, T1059.001, T1218.005."
    severity      = "HIGH"
    priority      = "HIGH"
    mitre_attack  = "T1204.002, T1059.001, T1218.005, T1105"

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /CurrentVersion\\Explorer\\RunMRU/i
    not $reg.target.registry.registry_key = /MRUList$/i

    (
      $reg.target.registry.registry_value_data = /(?i)powershell.{0,30}-enc/  or
      $reg.target.registry.registry_value_data = /(?i)powershell.{0,30}-EncodedCommand/ or
      $reg.target.registry.registry_value_data = /(?i)(IEX|Invoke-Expression)/ or
      $reg.target.registry.registry_value_data = /(?i)DownloadString/ or
      $reg.target.registry.registry_value_data = /(?i)Net\.WebClient/ or
      $reg.target.registry.registry_value_data = /(?i)powershell.{0,50}(hidden|bypass|noni|nop)/ or
      $reg.target.registry.registry_value_data = /(?i)mshta\s+https?:\/\// or
      $reg.target.registry.registry_value_data = /(?i)certutil.{0,20}-(urlcache|decode)/ or
      $reg.target.registry.registry_value_data = /(?i)bitsadmin.{0,20}\/transfer/ or
      $reg.target.registry.registry_value_data = /https?:\/\/[a-z0-9.-]+\/[^\s]{5,}/ or
      $reg.target.registry.registry_value_data = /(?i)cmd(\.exe)?\s+\/c.{0,200}&&/ or
      $reg.target.registry.registry_value_data = /(?i)rundll32.{0,30}(javascript:|vbscript:)/ or
      $reg.target.registry.registry_value_data = /(?i)regsvr32.{0,20}\/i:https?/
    )

    $hostname = $reg.principal.hostname
    $user     = $reg.principal.user.userid

    $proc.metadata.event_type   = "PROCESS_LAUNCH"
    $proc.principal.hostname    = $hostname
    $proc.principal.user.userid = $user
    $proc.principal.process.file.full_path = /(?i)explorer\.exe$/
    $proc.target.process.file.full_path = /(?i)(powershell\.exe|pwsh\.exe|cmd\.exe|mshta\.exe|wscript\.exe|cscript\.exe|certutil\.exe|bitsadmin\.exe|rundll32\.exe|regsvr32\.exe)$/

  match:
    $hostname, $user over 30s

  condition:
    #reg >= 1

  outcome:
    $risk_score = max(
      50 +
      if(#proc > 0, 25, 0) +
      if($reg.target.registry.registry_value_data = /(?i)-enc/, 15, 0) +
      if($reg.target.registry.registry_value_data = /https?:\/\//, 10, 0)
    )
    $attack_pattern = if(
      $reg.target.registry.registry_value_data = /(?i)powershell.{0,30}-enc/,
        "ClickFix - PowerShell Encoded Payload",
      if($reg.target.registry.registry_value_data = /(?i)mshta\s+https?/,
        "ClickFix - mshta Remote Script",
        "Suspicious Run Dialog Command")
      )
    $command_value   = $reg.target.registry.registry_value_data
    $spawned_process = $proc.target.process.file.full_path
}